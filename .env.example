# Токен от @BotFather (обязательно). Сюда НЕ вставляйте — держите его в файле .env
BOT_TOKEN=

# ID администраторов через запятую (необязательно). Узнать свой ID: команда /id
ADMIN_IDS=

# Путь к файлу базы данных (необязательно)
# DB_PATH=internetometer.db

# Объём теста скорости (верхняя граница), МБ, и длительность замера в секундах
DEFAULT_SPEEDTEST_MB=200
MAX_SPEEDTEST_MB=1000
SPEEDTEST_SECONDS=8

# Лимит мониторов на пользователя
MAX_MONITORS_PER_USER=10

# Максимальный размер файла для /download, МБ
MAX_DOWNLOAD_MB=25

# --- Telegram Web App (мини-приложение в боте) ---
# Публичный HTTPS-адрес приложения. Проще всего получить бесплатным туннелем:
#   cloudflared tunnel --url http://localhost:8787
# Вставьте сюда адрес вида https://xxxx.trycloudflare.com и перезапустите бота.
# Пустое значение — кнопка приложения и сервер не включаются.
WEBAPP_URL=

# Локальный адрес, на котором сервер отдаёт приложение (менять не нужно)
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8787